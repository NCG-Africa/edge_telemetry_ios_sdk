// Secrets.xcconfig — EdgeRum sample API key configuration.
//
// Committed with a placeholder so a fresh clone builds and runs (the
// SDK accepts any "edge_"-prefixed key; the backend returns 401 until
// the key is real). To send real telemetry, create a sibling
// Secrets.local.xcconfig with:
//
//     EDGE_RUM_API_KEY = edge_your_real_key
//
// That file is gitignored and its value overrides the placeholder via
// the optional #include below. Never commit a real key.
EDGE_RUM_API_KEY = edge_REPLACE_ME

#include? "Secrets.local.xcconfig"
